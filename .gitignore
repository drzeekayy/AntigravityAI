# AntigravityAI — Git Ignore Rules

# Environment / secrets — NEVER commit these
config/.env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
dist/
build/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs & backups (generated at runtime)
logs/*.log
backups/

# OS
.DS_Store
Thumbs.db
